rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo l'organizzatore (account Google verificato) può scrivere. Gli organizzatori sono i
    // documenti admins/<email>, creati a mano dalla console Firebase: l'email non sta nel codice.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Ognuno può solo controllare se è organizzatore (leggere il proprio documento): l'elenco
    // non si legge e non si scrive dal sito.
    match /admins/{email} {
      allow get: if request.auth != null
                 && request.auth.token.email_verified == true
                 && request.auth.token.email == email;
    }

    function isValidUrl(url) {
      return url is string && (url.size() == 0 || url.matches('https://lichess\\.org/.*'));
    }

    match /tournaments/{tournamentId} {
      // Tournament data (metadata, players, schedule) is publicly readable
      allow read: if true;
      // Writing tournament metadata requires valid title and season
      allow write: if isAdmin()
                   && request.resource.data.title is string
                   && request.resource.data.season is string;

      // Organizer-only notes (player anecdotes, settings, message texts): never public
      match /private/{docId} {
        allow read, write: if isAdmin();
      }

      // Archived seasons (final standings): public, written only by the organizer
      match /seasons/{seasonId} {
        allow read: if true;
        allow write: if isAdmin()
                     && request.resource.data.season is string
                     && request.resource.data.standings is list;
      }

      // Photos uploaded from the organizer area (one per season, see src/lib/media.ts): public,
      // written only by the organizer, and only as an image data URL below the document limit
      match /media/{mediaId} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
                     && request.resource.data.dataUrl is string
                     && request.resource.data.dataUrl.size() < 900000
                     && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,.*');
      }

      // Who accepted the rules of the season (src/lib/pledges.ts): public, so the page and the cronaca
      // show it. Written by the public page without signing in: one document per season and player,
      // only for the current season, only once (no update), with the server's time. The organizer can
      // cancel one, and the player accepts again.
      match /pledges/{pledgeId} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['handle', 'season', 'rules', 'at'])
                     && request.resource.data.handle is string
                     && request.resource.data.handle.matches('[a-z0-9_-]{2,30}')
                     && pledgeId.matches('[a-z0-9-]+--' + request.resource.data.handle)
                     && request.resource.data.season == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.season
                     && request.resource.data.rules is string
                     && request.resource.data.rules.matches('[0-9a-f]{8}')
                     && request.resource.data.at == request.time;
      }

      match /games/{gameId} {
        // Games are publicly readable so standings and matches can be displayed to all participants
        allow read: if true;
        // The organizer can delete games (used when a new season starts, after archiving)
        allow delete: if isAdmin();
        // Game records can be created/updated if they have valid round and player handles
        allow create, update: if isAdmin()
                     && request.resource.data.round is string
                     && request.resource.data.white is string
                     && request.resource.data.black is string
                     && (!('url' in request.resource.data) || isValidUrl(request.resource.data.url));
      }
    }
  }
}
