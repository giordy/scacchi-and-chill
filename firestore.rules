rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo l'organizzatore (account Google verificato) può scrivere. Gli organizzatori sono i
    // documenti admins/<email>, creati a mano dalla console Firebase: l'email non sta nel codice.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Ognuno può solo controllare se è organizzatore (leggere il proprio documento): l'elenco
    // non si legge e non si scrive dal sito.
    match /admins/{email} {
      allow get: if request.auth != null
                 && request.auth.token.email_verified == true
                 && request.auth.token.email == email;
    }

    function isValidUrl(url) {
      return url is string && (url.size() == 0 || url.matches('https://lichess\\.org/.*'));
    }

    match /tournaments/{tournamentId} {
      // Tournament data (metadata, players, schedule) is publicly readable
      allow read: if true;
      // Writing tournament metadata requires valid title and season
      allow write: if isAdmin()
                   && request.resource.data.title is string
                   && request.resource.data.season is string;

      // Organizer-only notes (player anecdotes, settings, message texts): never public
      match /private/{docId} {
        allow read, write: if isAdmin();
      }

      // Archived seasons (final standings): public, written only by the organizer
      match /seasons/{seasonId} {
        allow read: if true;
        allow write: if isAdmin()
                     && request.resource.data.season is string
                     && request.resource.data.standings is list;
      }

      // Photos uploaded from the organizer area (one per season, see src/lib/media.ts): public,
      // written only by the organizer, and only as an image data URL below the document limit
      match /media/{mediaId} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
                     && request.resource.data.dataUrl is string
                     && request.resource.data.dataUrl.size() < 900000
                     && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,.*');
      }

      // Who accepted the rules of the season (src/lib/pledges.ts): public, so the page and the cronaca
      // show it. Written by the public page without signing in: one document per season and player,
      // only for the current season, only once (no update), with the server's time. The organizer can
      // cancel one, and the player accepts again.
      // The tournament keeps the ids of the documents that may be written this season, one per player
      // (lib/pledges.ts pledgeKeys): only a player of the season accepts, only under the season's id.
      // A tournament saved before the list existed is not checked; the organizer area adds it.
      function isPledgeOfSeason(pledgeId) {
        let t = get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        return !('pledgeKeys' in t) || pledgeId in t.pledgeKeys;
      }

      match /pledges/{pledgeId} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['handle', 'season', 'rules', 'at'])
                     && request.resource.data.handle is string
                     && request.resource.data.handle.matches('[a-z0-9_-]{2,30}')
                     && pledgeId.matches('[a-z0-9-]+--' + request.resource.data.handle)
                     && request.resource.data.season == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.season
                     && request.resource.data.rules is string
                     && request.resource.data.rules.matches('[0-9a-f]{8}')
                     && request.resource.data.at == request.time
                     && isPledgeOfSeason(pledgeId);
      }

      // Who gets the push notifications of the moves (src/lib/push.ts, scripts/push.mjs). Written by
      // the public page without signing in, never read from the site: the address of a browser's
      // push service is its own. The id is a random secret kept by that browser, so who knows it
      // is the browser itself: it may write its document again (new keys, another name to skip) or
      // delete it. The address must be one of a browser's push services, the only ones the GitHub
      // Action sends to; skip, when given, is a Lichess handle.
      match /pushSubscriptions/{subId} {
        allow delete: if subId.matches('[A-Za-z0-9_-]{32,64}');
        allow create, update: if subId.matches('[A-Za-z0-9_-]{32,64}')
                     && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'skip', 'at'])
                     && request.resource.data.endpoint is string
                     && request.resource.data.endpoint.size() < 1000
                     && request.resource.data.endpoint.matches('https://(fcm\\.googleapis\\.com|updates\\.push\\.services\\.mozilla\\.com|web\\.push\\.apple\\.com|[a-z0-9.-]+\\.notify\\.windows\\.com)/[^ ]+')
                     && request.resource.data.p256dh is string
                     && request.resource.data.p256dh.matches('[A-Za-z0-9_-]{80,100}')
                     && request.resource.data.auth is string
                     && request.resource.data.auth.matches('[A-Za-z0-9_-]{16,30}')
                     && (!('skip' in request.resource.data) || (request.resource.data.skip is string && request.resource.data.skip.matches('[a-z0-9_-]{0,30}')))
                     && request.resource.data.at == request.time;
      }

      match /games/{gameId} {
        // Games are publicly readable so standings and matches can be displayed to all participants
        allow read: if true;
        // The organizer can delete games (used when a new season starts, after archiving)
        allow delete: if isAdmin();
        // Game records can be created/updated if they have valid round and player handles
        allow create, update: if isAdmin()
                     && request.resource.data.round is string
                     && request.resource.data.white is string
                     && request.resource.data.black is string
                     && (!('url' in request.resource.data) || isValidUrl(request.resource.data.url));
      }
    }
  }
}
