{
  "entities": {
    "Tournament": {
      "title": "Tournament",
      "type": "object",
      "description": "Tournament state, metadata, players list and schedule",
      "properties": {
        "title": { "type": "string" },
        "season": { "type": "string" },
        "subtitle": { "type": "string" },
        "imageUrl": { "type": "string" },
        "masterName": { "type": "string" },
        "description": { "type": "string" },
        "rulesText": { "type": "string" },
        "howItWorks": { "type": "string" },
        "fairPlayText": { "type": "string" },
        "winners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "season": { "type": "string" },
              "name": { "type": "string" },
              "handle": { "type": "string" },
              "year": { "type": "string" },
              "notes": { "type": "string" }
            },
            "required": ["season", "name", "handle"]
          }
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "handle": { "type": "string" },
              "name": { "type": "string" }
            },
            "required": ["handle", "name"]
          }
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round": { "type": "string" },
              "white": { "type": "string" },
              "black": { "type": "string" },
              "url": { "type": "string" }
            },
            "required": ["round", "white", "black"]
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "season"]
    },
    "Game": {
      "title": "Game",
      "type": "object",
      "description": "A scheduled or played game in the tournament",
      "properties": {
        "round": { "type": "string" },
        "white": { "type": "string" },
        "black": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["round", "white", "black"]
    }
  },
  "firestore": {
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Stores tournament information, players, and official schedule"
    },
    "/tournaments/{tournamentId}/games/{gameId}": {
      "schema": "Game",
      "description": "Stores individual games and their Lichess challenge URLs"
    }
  }
}
